# Copy this file to .env and fill in the values.

# Working database for the MCP server and the backend.
# The original data/campus_customs.db is never touched; run scripts/reset_db.py to start over.
CAMPUS_DB_PATH=data/campus_customs_new.db

# Model calls: every agent uses gpt-6-luna through Portkey (same key as HMW 4).
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_MODEL=gpt-6-luna
